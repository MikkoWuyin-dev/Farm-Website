{
  "name": "agrarium-clone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Pixel-accurate React + TypeScript rebuild of the Agrarium agriculture demo (demo.artureanec.com/themes/agrarium)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --noEmit false --pretty",
    "assets:local": "node tools/download-assets.mjs --rewrite"
  },
  "dependencies": {
    "@fontsource/kaushan-script": "^5.1.0",
    "@fontsource/manrope": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
